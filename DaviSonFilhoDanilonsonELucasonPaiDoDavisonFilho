local Fog = { on = false, stash = {}, origFogEnd = nil }

local function fogStart()
    if Fog.on then return end
    Fog.on = true
    Fog.origFogEnd = Fog.origFogEnd or Lighting.FogEnd
    for _, name in ipairs({"LightingLayers", "Sky"}) do
        local obj = Lighting:FindFirstChild(name)
        if obj then
            Fog.stash[#Fog.stash + 1] = {obj = obj, parent = Lighting}
            obj.Parent = nil
        end
    end
    task.spawn(function()
        while Fog.on do
            Lighting.FogEnd = 9e9
            task.wait(0.5)
        end
    end)
end

local function fogStop()
    if not Fog.on then return end
    Fog.on = false
    for i = #Fog.stash, 1, -1 do
        local e = Fog.stash[i]
        pcall(function() e.obj.Parent = e.parent end)
    end
    Fog.stash = {}
    if Fog.origFogEnd then Lighting.FogEnd = Fog.origFogEnd end
end

