local Tabs, tabCount = {}, 0

local function relayoutTabs()
    for _, t in pairs(Tabs) do
        t.Button.Size = UDim2.new(1 / tabCount, -4, 1, -6)
    end
end

local function createTab(name, label)
    tabCount += 1

    local btn = new("TextButton", {
        BackgroundColor3 = T.ACCENT, BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = label, TextColor3 = T.DIM, Font = Enum.Font.GothamBold,
        TextSize = 11, TextScaled = true, AutoButtonColor = false,
        LayoutOrder = tabCount, ZIndex = 3,
    }, TabBar)
    corner(btn, 6)
    new("UITextSizeConstraint", {MaxTextSize = 11, MinTextSize = 7}, btn)

    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = T.ACCENT,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, ZIndex = 2,
    }, Content)
    new("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, page)
    new("UIPadding", {PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 6)}, page)

    Tabs[name] = {Button = btn, Page = page}

    local function select()
        for _, t in pairs(Tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.15),
                {BackgroundTransparency = 1, TextColor3 = T.DIM}):Play()
        end
        page.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.15),
            {BackgroundTransparency = 0, TextColor3 = Color3.new(1, 1, 1)}):Play()
    end
    Tabs[name].Select = select
    btn.MouseButton1Click:Connect(select)

    relayoutTabs()
    return page
end

