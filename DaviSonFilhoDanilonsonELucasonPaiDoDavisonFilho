-- TP LOCK 2
-- ============================================================
local LOCK = {
    speed        = 180,
    snapDist     = 70,
    snapInterval = 0.01,
    lead         = 0.18,
    offset       = Vector3.new(0, 0, 0),
}

local Lock = { target = nil, conn = nil, tween = nil, lastSnap = 0, lastTween = 0, noclip = {} }
local rows = {}
local refreshButtons

local function cancelTween()
    if Lock.tween then Lock.tween:Cancel(); Lock.tween = nil end
end

local function lockNoclip(char)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            Lock.noclip[p] = true
            p.CanCollide = false
        end
    end
end

local function lockRestore()
    for p in pairs(Lock.noclip) do
        if p.Parent then p.CanCollide = true end
    end
    table.clear(Lock.noclip)
end

local function stopLock()
    if Lock.conn then Lock.conn:Disconnect(); Lock.conn = nil end
    cancelTween()
    lockRestore()
    Lock.target = nil
    local hum = getHum(LocalPlayer.Character)
    if hum and hum.Health > 0 then hum:ChangeState(Enum.HumanoidStateType.Running) end
    if refreshButtons then refreshButtons() end
end

local function stepLock()
    local target = Lock.target
    if not target or not target.Parent then return stopLock() end

    local myChar = LocalPlayer.Character
    local myHRP, myHum = getHRP(myChar), getHum(myChar)
    local tChar = target.Character
    local tHRP, tHum = getHRP(tChar), getHum(tChar)

    if not (myHRP and myHum and myHum.Health > 0 and tHRP and tHum and tHum.Health > 0) then
        cancelTween()
        return
    end

    lockNoclip(myChar)

    local now = os.clock()
    local goal = tHRP.CFrame + LOCK.offset
    local dist = (tHRP.Position - myHRP.Position).Magnitude

    if dist <= LOCK.snapDist then
        cancelTween()
        myHRP.AssemblyLinearVelocity = Vector3.zero
        if now - Lock.lastSnap >= LOCK.snapInterval then
            Lock.lastSnap = now
            myHRP.CFrame = goal + tHRP.AssemblyLinearVelocity * LOCK.lead
        end
    elseif now - Lock.lastTween >= 0.05 then
        Lock.lastTween = now
        cancelTween()
        myHum:ChangeState(Enum.HumanoidStateType.Physics)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        Lock.tween = TweenService:Create(
            myHRP,
            TweenInfo.new(dist / math.max(LOCK.speed, 1), Enum.EasingStyle.Linear),
            {CFrame = goal}
        )
        Lock.tween:Play()
    end
end

local function startLock(player)
    stopLock()
    Lock.target = player
    Lock.lastSnap, Lock.lastTween = 0, 0
    Lock.conn = RunService.Stepped:Connect(stepLock)
    refreshButtons()
end

