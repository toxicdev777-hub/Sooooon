-- remove objetos (tira da árvore e guarda; desligar devolve)
local function makeStasher(pred)
    local st = {stash = {}, conn = nil}
    local function try(v)
        if v.Parent and pred(v) then
            st.stash[#st.stash + 1] = {obj = v, parent = v.Parent}
            v.Parent = nil
        end
    end
    function st.start()
        if st.conn then return end
        pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do try(v) end
            for _, v in ipairs(ReplicatedStorage:GetDescendants()) do try(v) end
        end)
        st.conn = Workspace.DescendantAdded:Connect(function(v) task.defer(try, v) end)
    end
    function st.stop()
        if st.conn then st.conn:Disconnect(); st.conn = nil end
        for i = #st.stash, 1, -1 do
            local e = st.stash[i]
            pcall(function() e.obj.Parent = e.parent end)
        end
        st.stash = {}
    end
    return st
end

local function isLava(v)
    if v.Name == "Lava" then return true end
    if v.Name == "LavaParts" then
        local p = v.Parent
        if p and (p.Name == "CircleIsland" or p.Name == "GhostShipInterior") then
            local gp = p.Parent
            return gp ~= nil and gp.Name == "Map"
        end
    end
    return false
end

-- lava dentro do Cursed Ship (GhostShipInterior)
local function isCursedShipLava(v)
    if v.Name ~= "Lava" and v.Name ~= "LavaParts" then return false end
    local p = v.Parent
    while p do
        if p.Name == "GhostShipInterior" then return true end
        p = p.Parent
    end
    return false
end

