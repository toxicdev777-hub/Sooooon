local function hideLockVisuals()
    aimLine.Visible = false
    for _, r in ipairs(rings) do r.frame.Visible = false end
end

local function ringsUpdate(pos)
    local now = os.clock()
    local hueShift = now / 3
    for i, r in ipairs(rings) do
        local phase = ((now - (i - 1) * 1.1 / 3) % 1.1) / 1.1
        local rad = 26 + 30 * phase
        r.frame.Position = UDim2.fromOffset(pos.X, pos.Y)
        r.frame.Size = UDim2.fromOffset(rad * 2, rad * 2)
        r.stroke.Transparency = phase * 0.85
        r.stroke.Color = Color3.fromHSV((hueShift + (i - 1) / 3) % 1, 1, 1)
        r.frame.Visible = true
    end
end

