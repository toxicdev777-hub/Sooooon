local ESP = {
    cfg = {
        Enabled = false, Name = true, Level = true, Bounty = true, Fruit = true,
        Distance = true, HP = true, TextSize = 14, Highlight = false,
        HighlightColor = "FF0000",
    },
    objects = {}, cache = {}, running = false, lastUpdate = 0, interval = 0.1,
}

local function getTeamInfo(player)
    if not player.Team then return "Unknown", Color3.fromRGB(255, 255, 255) end
    if player.Team.Name == "Marines" then
        return "Marines", Color3.fromRGB(0, 170, 255)
    end
    return "Pirates", Color3.fromRGB(255, 70, 70)
end

local function hexToColor3(hex)
    local r = (tonumber(hex:sub(1, 2), 16) or 255) / 255
    local g = (tonumber(hex:sub(3, 4), 16) or 0) / 255
    local b = (tonumber(hex:sub(5, 6), 16) or 0) / 255
    return Color3.new(r, g, b)
end

local function removeESP(player)
    local o = ESP.objects[player]
    if o then
        pcall(function()
            o.gui:Destroy()
            if o.highlight then o.highlight:Destroy() end
        end)
        ESP.objects[player] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end

    local _, color = getTeamInfo(player)
    local billboard = new("BillboardGui", {
        Adornee = head, Size = UDim2.new(0, 220, 0, 110),
        StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true,
    })
    local label = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextScaled = false,
        TextSize = ESP.cfg.TextSize, RichText = true, Font = Enum.Font.SourceSansBold,
        TextStrokeTransparency = 0, TextColor3 = color,
    }, billboard)
    billboard.Parent = head

    local highlight
    if ESP.cfg.Highlight then
        local hl = hexToColor3(ESP.cfg.HighlightColor)
        highlight = new("Highlight", {
            Name = "ESP_PlayerHighlight", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillColor = hl, FillTransparency = 0.5, OutlineColor = hl, OutlineTransparency = 0,
        }, char)
    end

    ESP.objects[player] = {gui = billboard, label = label, char = char, highlight = highlight}
end

local function getPlayerData(player)
    local data = ESP.cache[player]
    if not data then
        data = {level = "?", fruit = "None", bounty = 0, team = "Unknown",
            color = Color3.fromRGB(255, 255, 255), lastUpdate = 0}
        ESP.cache[player] = data
    end
    local now = tick()
    if now - data.lastUpdate > 5 then
        pcall(function() data.level = player.Data.Level.Value end)
        pcall(function() data.fruit = player.Data.DevilFruit.Value end)
        pcall(function() data.bounty = player.leaderstats["Bounty/Honor"].Value end)
        data.team, data.color = getTeamInfo(player)
        data.lastUpdate = now
    end
    return data
end

local function updateESP()
    local now = tick()
    if now - ESP.lastUpdate < ESP.interval then return end
    ESP.lastUpdate = now

    local myRoot = getHRP(LocalPlayer.Character)
    if not myRoot then return end
    local myPos = myRoot.Position
    local cfg = ESP.cfg

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            local data = ESP.objects[player]

            if char and head then
                if not data or data.char ~= char or not data.gui.Parent then
                    removeESP(player)
                    createESP(player)
                    data = ESP.objects[player]
                end
            else
                if data then removeESP(player) end
                data = nil
            end

            local hum, root = getHum(char), getHRP(char)
            if data and hum and root then
                local distance = math.floor((root.Position - myPos).Magnitude)
                local hp = math.floor((hum.Health / hum.MaxHealth) * 100)
                local pData = getPlayerData(player)
                local bounty = pData.bounty
                local warnTag = bounty > 10000000 and "⚠ " or ""

                local pvpState, pvpIcon, pvpOff = "PVP Enabled ", "🔴 ", false
                if player:GetAttribute("PvpDisabled") == true then
                    pvpState, pvpIcon, pvpOff = "PvP Disabled ", "🟢 ", true
                end

                data.label.TextColor3 = pData.color
                if data.label.TextSize ~= cfg.TextSize then data.label.TextSize = cfg.TextSize end

                local parts = {}
                if cfg.Name then
                    parts[#parts + 1] = warnTag .. "[" .. pData.team .. "] <font color=\"rgb(255,255,0)\">" .. player.Name .. "</font>"
                end
                if cfg.Level then parts[#parts + 1] = " [Lv." .. pData.level .. "]" end
                if pvpOff then
                    parts[#parts + 1] = "\n<font color=\"rgb(0,255,0)\">" .. pvpIcon .. pvpState .. "</font>\n"
                else
                    parts[#parts + 1] = "\n" .. pvpIcon .. pvpState .. "\n"
                end
                if cfg.Fruit then parts[#parts + 1] = "Fruit: " .. pData.fruit .. "\n" end
                if cfg.Bounty then parts[#parts + 1] = "Bounty: " .. math.floor(bounty / 1000000) .. "M\n" end
                if cfg.Distance then parts[#parts + 1] = distance .. "m | " end
                if cfg.HP then parts[#parts + 1] = "HP " .. hp .. "%" end
                data.label.Text = table.concat(parts)

                if cfg.Highlight then
                    local hl = hexToColor3(cfg.HighlightColor)
                    if not data.highlight or not data.highlight.Parent then
                        data.highlight = new("Highlight", {
                            Name = "ESP_PlayerHighlight", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                            FillColor = hl, FillTransparency = 0.5, OutlineColor = hl, OutlineTransparency = 0,
                        }, char)
                    else
                        data.highlight.FillColor = hl
                        data.highlight.OutlineColor = hl
                    end
                elseif data.highlight then
                    data.highlight:Destroy()
                    data.highlight = nil
                end
            end
        end
    end
end

local function enableESP()
    if ESP.running then return end
    ESP.running = true
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
    task.spawn(function()
        while ESP.running do
            pcall(updateESP)
            task.wait(ESP.interval)
        end
    end)
end

local function disableESP()
    ESP.running = false
    for player in pairs(ESP.objects) do removeESP(player) end
    ESP.objects = {}
end

