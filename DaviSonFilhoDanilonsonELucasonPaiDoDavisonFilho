local function aimOrigin()
    local cam = Workspace.CurrentCamera
    local p = UIS:GetMouseLocation()
    if A.fovMode == "Centro da tela" or p.X <= 0 or p.Y <= 0 then
        local v = cam.ViewportSize
        return Vector2.new(v.X / 2, v.Y / 2)
    end
    return p
end

local function pickTarget()
    local cam = Workspace.CurrentCamera
    if A.method == "Player escolhido" then
        if not A.players or A.selected == "" then return nil end
        local p = Players:FindFirstChild(A.selected)
        if not p or not playerAllowed(p) or not isAlive(p.Character) then return nil end
        return aimPart(p.Character)
    end

    local myRoot = getHRP(LocalPlayer.Character)
    local origin = aimOrigin()
    local best, bestVal = nil, math.huge

    local function consider(char)
        if not isAlive(char) then return end
        local part = aimPart(char)
        if not part then return end
        if A.method == "Player mais perto" then
            if not myRoot then return end
            local d = (part.Position - myRoot.Position).Magnitude
            if d < bestVal then best, bestVal = part, d end
        else
            local pos, on = cam:WorldToViewportPoint(part.Position)
            if on then
                local d = (Vector2.new(pos.X, pos.Y) - origin).Magnitude
                if d <= A.fovRadius and d < bestVal then best, bestVal = part, d end
            end
        end
    end

    if A.players then
        for _, p in ipairs(Players:GetPlayers()) do
            if playerAllowed(p) then consider(p.Character) end
        end
    end
    if A.mobs then
        local e = Workspace:FindFirstChild("Enemies")
        if e then
            for _, m in ipairs(e:GetChildren()) do consider(m) end
        end
    end
    return best
end

-- HOOKS (silent aim): só instalam se o executor tiver suporte
local H = {}

local function ncHook(self, ...)
    local method = getnamecallmethod and getnamecallmethod()
    if A.skill and A.part and (method == "FireServer" or method == "InvokeServer") and skillSelected() then
        local n = tostring(self)
        if n == "RemoteEvent" or n == "CommE" or n == "RemoteFunction" then
            local args = table.pack(...)
            local pos = A.part.Position
            for i = 1, args.n do
                if typeof(args[i]) == "Vector3" then args[i] = pos end
            end
            return H.nc(self, table.unpack(args, 1, args.n))
        end
    end
    return H.nc(self, ...)
end

local function idxHook(t, k)
    if A.m1r and A.part and t == mouse and skillSelected()
        and not (checkcaller and checkcaller()) then
        local tp = A.part.Position
        local cam = Workspace.CurrentCamera
        local cp = cam.CFrame.Position
        if k == "Hit" then return CFrame.new(tp)
        elseif k == "Target" then return A.part
        elseif k == "UnitRay" then return Ray.new(cp, (tp - cp).Unit)
        elseif k == "Origin" then return cp
        elseif k == "Direction" then return (tp - cp).Unit
        end
    end
    return H.idx(t, k)
end

local function patchMouseModule()
    local inst = ReplicatedStorage:FindFirstChild("Mouse")
    if not inst or not getrawmetatable or not setreadonly then return end
    local ok, mod = pcall(require, inst)
    if not ok or typeof(mod) ~= "table" then return end
    pcall(function()
        local real = {Hit = rawget(mod, "Hit"), Target = rawget(mod, "Target")}
        local mt = getrawmetatable(mod)
        if mt then setreadonly(mt, false) else mt = {}; setmetatable(mod, mt) end
        rawset(mod, "Hit", nil)
        rawset(mod, "Target", nil)
        mt.__index = function(_, key)
            if key == "Hit" then
                if A.skill and A.part and skillSelected() then return CFrame.new(A.part.Position) end
                return real.Hit
            elseif key == "Target" then
                if A.skill and A.part and skillSelected() then return A.part end
                return real.Target
            end
        end
        mt.__newindex = function(self, key, value)
            if key == "Hit" or key == "Target" then real[key] = value else rawset(self, key, value) end
        end
    end)
end

local function installHooks()
    if A.hooked ~= nil then return A.hooked end
    local wrap = newcclosure or function(f) return f end
    local ok = pcall(function()
        if hookmetamethod then
            H.nc = hookmetamethod(game, "__namecall", wrap(ncHook))
            H.idx = hookmetamethod(game, "__index", wrap(idxHook))
        elseif getrawmetatable and setreadonly then
            local mt = getrawmetatable(game)
            H.nc, H.idx = mt.__namecall, mt.__index
            setreadonly(mt, false)
            mt.__namecall = wrap(ncHook)
            mt.__index = wrap(idxHook)
            setreadonly(mt, true)
        else
            error("sem API de hook")
        end
    end)
    A.hooked = ok
    if ok then patchMouseModule() end
    return ok
end

