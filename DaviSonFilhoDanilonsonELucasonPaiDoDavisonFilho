-- AURA: BRING MOB (NPCs puxados pra baixo do pé e congelados)
-- ============================================================
local BRING = {
    range      = 500,
    feetOffset = 17,
    ownerCheck = 300,
}

local Bring = { conn = nil, cache = {} }

local function bringParts(enemy)
    local c = Bring.cache[enemy]
    if c and c.hum.Parent and c.root.Parent then return c end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    local root = enemy:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        Bring.cache[enemy] = nil
        return nil
    end
    c = {
        hum = hum, root = root, cleared = false,
        orig = {ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight, ujp = hum.UseJumpPower},
    }
    Bring.cache[enemy] = c
    return c
end

local function bringIsOwner(root)
    local chars = Workspace:FindFirstChild("Characters")
    if not chars then return true end
    for _, other in ipairs(chars:GetChildren()) do
        if other.Name ~= LocalPlayer.Name then
            local oRoot = other:FindFirstChild("HumanoidRootPart")
            if oRoot and (oRoot.Position - root.Position).Magnitude <= BRING.ownerCheck then
                return false
            end
        end
    end
    return true
end

local function stopBring()
    if Bring.conn then Bring.conn:Disconnect(); Bring.conn = nil end
    for _, c in pairs(Bring.cache) do
        if c.hum.Parent then
            pcall(function()
                c.hum.UseJumpPower = c.orig.ujp
                c.hum.WalkSpeed = c.orig.ws
                c.hum.JumpPower = c.orig.jp
                c.hum.JumpHeight = c.orig.jh
            end)
        end
    end
    Bring.cache = {}
end

local function startBring()
    if Bring.conn then return end
    Bring.conn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            local hrp, hum = getHRP(char), getHum(char)
            if not hrp or not hum or hum.Health <= 0 then return end

            if sethiddenproperty then
                pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
            end

            local feet = hrp.Position - Vector3.new(0, BRING.feetOffset, 0)
            local enemies = Workspace:FindFirstChild("Enemies")
            if not enemies then return end

            for _, enemy in ipairs(enemies:GetChildren()) do
                if enemy:IsA("Model") then
                    local c = bringParts(enemy)
                    if c and c.hum.Health > 0 then
                        local d = (c.root.Position - feet).Magnitude
                        if d <= BRING.range then
                            if not c.cleared then
                                for _, part in ipairs(enemy:GetDescendants()) do
                                    if part:IsA("BasePart") and part.CanCollide then
                                        part.CanCollide = false
                                    end
                                end
                                c.cleared = true
                            end
                            c.hum.UseJumpPower = true
                            c.hum.WalkSpeed = 0
                            c.hum.JumpPower = 0
                            c.hum.JumpHeight = 0
                            if d > 0.5 and bringIsOwner(c.root) then
                                c.root.CFrame = CFrame.new(feet)
                            end
                        end
                    end
                end
            end
        end)
    end)
end

