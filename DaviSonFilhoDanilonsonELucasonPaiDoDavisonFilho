    end

    if not (A.m1r or A.skill or A.showLine or A.camAim) then
        A.part = nil
        hideLockVisuals()
        return
    end

    A.part = pickTarget()

    if A.camAim and A.part then
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, A.part.Position), 0.35)
    end

    if A.showLine and A.part then
        local pos, on = cam:WorldToViewportPoint(A.part.Position)
        if on then
            local o = aimOrigin()
            local tgt = Vector2.new(pos.X, pos.Y)
            local d = tgt - o
            aimLine.Size = UDim2.fromOffset(d.Magnitude, 2)
            aimLine.Position = UDim2.fromOffset((o.X + tgt.X) / 2, (o.Y + tgt.Y) / 2)
            aimLine.Rotation = math.deg(math.atan2(d.Y, d.X))
            aimLine.Visible = true
            ringsUpdate(tgt)
            return
        end
    end
    hideLockVisuals()
end)

